{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepoAtlas",
  "version": "0.1.0-beta.3",
  "identifier": "io.repoatlas.desktop",
  "build": {
    "beforeDevCommand": "node scripts/copy-mcp-sidecar.mjs && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/copy-mcp-sidecar.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RepoAtlas",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "resources": [
      "resources/repoatlas-mcp/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGNDc3M0I5NUNDQjAwMgpSV1FDc015Vk8zZjBBMy9FYm5WQXZHYmtxZlpCOE85L3FtUFFmdmpLcEtLaEdQUUxhaVNVbHAwYQo=",
      "endpoints": [
        "https://github.com/Wujerry/RepoAtlas/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
