    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "@xterm/addon-fit": "^0.11.0",
